# Normalize all text files to LF in the repository.
* text=auto

# Explicit LF for source and build scripts (prevents CRLF drift on Windows checkouts).
*.java text eol=lf
*.kt text eol=lf
*.aidl text eol=lf
*.gradle text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.pro text eol=lf
*.ps1 text eol=lf
gradlew text eol=lf
