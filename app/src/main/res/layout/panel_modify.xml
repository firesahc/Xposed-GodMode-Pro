<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/rounded_bg_full"
    android:orientation="vertical"
    android:padding="12dp"
    android:tag="@string/tag_gm_cmp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/modify_title"
        android:textColor="?android:textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:tag="@string/tag_gm_cmp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/modify_width"
        android:textColor="?android:textColorSecondary"
        android:textSize="12sp"
        android:tag="@string/tag_gm_cmp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:tag="@string/tag_gm_cmp">

        <SeekBar
            android:id="@+id/mod_width_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="2000"
            android:tag="@string/tag_gm_cmp" />

        <EditText
            android:id="@+id/mod_width_text"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="12sp"
            android:tag="@string/tag_gm_cmp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/modify_height"
        android:textColor="?android:textColorSecondary"
        android:textSize="12sp"
        android:tag="@string/tag_gm_cmp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:tag="@string/tag_gm_cmp">

        <SeekBar
            android:id="@+id/mod_height_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="2000"
            android:tag="@string/tag_gm_cmp" />

        <EditText
            android:id="@+id/mod_height_text"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="12sp"
            android:tag="@string/tag_gm_cmp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/modify_alpha"
        android:textColor="?android:textColorSecondary"
        android:textSize="12sp"
        android:tag="@string/tag_gm_cmp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:tag="@string/tag_gm_cmp">

        <SeekBar
            android:id="@+id/mod_alpha_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255"
            android:tag="@string/tag_gm_cmp" />

        <EditText
            android:id="@+id/mod_alpha_text"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="12sp"
            android:tag="@string/tag_gm_cmp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/modify_position"
        android:textColor="?android:textColorSecondary"
        android:textSize="12sp"
        android:tag="@string/tag_gm_cmp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:tag="@string/tag_gm_cmp">

        <Button
            android:id="@+id/mod_pos_left"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:text="◀"
            android:textSize="14sp"
            android:tag="@string/tag_gm_cmp" />

        <Button
            android:id="@+id/mod_pos_up"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:text="▲"
            android:textSize="14sp"
            android:tag="@string/tag_gm_cmp" />

        <Button
            android:id="@+id/mod_pos_down"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:text="▼"
            android:textSize="14sp"
            android:tag="@string/tag_gm_cmp" />

        <Button
            android:id="@+id/mod_pos_right"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:text="▶"
            android:textSize="14sp"
            android:tag="@string/tag_gm_cmp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mod_text_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:tag="@string/tag_gm_cmp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/modify_text"
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp"
            android:tag="@string/tag_gm_cmp" />

        <EditText
            android:id="@+id/mod_text_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:textSize="12sp"
            android:tag="@string/tag_gm_cmp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mod_image_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:tag="@string/tag_gm_cmp">

        <Button
            android:id="@+id/mod_image_pick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/modify_image_pick"
            android:textSize="12sp"
            android:tag="@string/tag_gm_cmp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:tag="@string/tag_gm_cmp">

        <Button
            android:id="@+id/mod_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/modify_cancel"
            android:textSize="12sp"
            android:tag="@string/tag_gm_cmp" />

        <Button
            android:id="@+id/mod_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/modify_save"
            android:textSize="12sp"
            android:tag="@string/tag_gm_cmp" />
    </LinearLayout>

</LinearLayout>
