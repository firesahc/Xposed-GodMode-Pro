<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="left"
    android:tag="@string/tag_gm_cmp">

    <LinearLayout
        android:id="@+id/topcentent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|right|center_horizontal"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:tag="@string/tag_gm_cmp">

        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/rounded_bg_full"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:tag="@string/tag_gm_cmp"
            android:translationZ="9dp"
            tools:gravity="right">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="160dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:tag="@string/tag_gm_cmp">

                <SeekBar
                    android:id="@+id/slider"
                    android:layout_width="160dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:rotation="90"
                    android:tag="@string/tag_gm_cmp" />

            </FrameLayout>

            <ImageButton
                android:id="@+id/exchange"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/ripple_drawable_20dp"
                android:contentDescription="@string/accessibility_exchange"
                android:src="@drawable/exchange"
                android:tag="@string/tag_gm_cmp" />

            <FrameLayout
                android:id="@+id/info_flow_mode_toggle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:tag="@string/tag_gm_cmp">
                <TextView
                    android:id="@+id/info_flow_mode_btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/ripple_drawable_20dp"
                    android:gravity="center"
                    android:text="@string/mode_info_flow_off"
                    android:textColor="@color/info_flow_btn_text"
                    android:textSize="11sp"
                    android:tag="@string/tag_gm_cmp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/remove_mode_toggle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:tag="@string/tag_gm_cmp">

                <TextView
                    android:id="@+id/remove_mode_btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/ripple_drawable_20dp"
                    android:gravity="center"
                    android:text="@string/mode_remove"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="11sp"
                    android:tag="@string/tag_gm_cmp" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/remove_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:tag="@string/tag_gm_cmp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:background="@drawable/rounded_bg_bottom_background"
                    android:tag="@string/tag_gm_cmp">

                    <ImageButton
                        android:id="@+id/block"
                        android:layout_width="48dp"
                        android:layout_height="53dp"
                        android:layout_gravity="center"
                        android:background="@drawable/ripple_drawable_20dp"
                        android:contentDescription="@string/accessibility_block"
                        android:src="@drawable/ic_block"
                        android:tag="@string/tag_gm_cmp" />

                </FrameLayout>

                <ImageButton
                    android:id="@+id/preview"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ripple_drawable_20dp"
                    android:contentDescription="@string/accessibility_preview"
                    android:src="@android:drawable/ic_menu_view"
                    android:tag="@string/tag_gm_cmp" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/modify_mode_toggle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:tag="@string/tag_gm_cmp">

                <TextView
                    android:id="@+id/modify_mode_btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/ripple_drawable_20dp"
                    android:gravity="center"
                    android:text="@string/mode_modify"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="11sp"
                    android:tag="@string/tag_gm_cmp" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/modify_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:tag="@string/tag_gm_cmp">

                <ImageButton
                    android:id="@+id/modify"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ripple_drawable_20dp"
                    android:contentDescription="@string/accessibility_modify"
                    android:src="@android:drawable/ic_menu_edit"
                    android:tag="@string/tag_gm_cmp" />

                <ImageButton
                    android:id="@+id/modify_preview"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ripple_drawable_20dp"
                    android:contentDescription="@string/accessibility_modify_preview"
                    android:src="@android:drawable/ic_menu_view"
                    android:tag="@string/tag_gm_cmp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/undo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/ripple_drawable_20dp"
                android:contentDescription="@string/accessibility_undo"
                android:enabled="false"
                android:src="@drawable/ic_undo"
                android:tag="@string/tag_gm_cmp" />

            <ImageButton
                android:id="@+id/Up"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/ripple_drawable_20dp"
                android:contentDescription="@string/accessibility_up"
                android:src="@drawable/up"
                android:tag="@string/tag_gm_cmp" />

            <ImageButton
                android:id="@+id/Down"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/ripple_drawable_20dp"
                android:contentDescription="@string/accessibility_down"
                android:src="@drawable/down"
                android:tag="@string/tag_gm_cmp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
