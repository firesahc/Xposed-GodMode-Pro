<?xml version="1.0" encoding="utf-8"?>
<!-- 横屏双列单卡：复用竖屏同 id 同内容，仅工具列改为横向双列（左操作组/右选择组，选择区居右外侧） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 外层定位容器：靠右垂直居中；左右 padding 均为 8dp 对称 -->
    <LinearLayout
        android:id="@+id/top_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|center_vertical"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp">

        <!-- 横屏工具列：横向双列单背景 + translationZ 保留；上下 6dp、左右 8dp 对称 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:background="@drawable/rounded_bg_full"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:translationZ="9dp"
            tools:gravity="right">

            <!-- 操作组在左（内侧）：信息流开关 + 移除开关/菜单 + 修改开关/菜单 + 撤销；顺序与竖屏一致 -->
            <!-- 组内节奏：首项 marginTop 0，其余直接子项 marginTop 4（含菜单容器与 undo）；菜单内首次 0、次 4 -->
            <LinearLayout
                android:id="@+id/action_group"
                android:layout_width="@dimen/panel_action_col_w"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/info_flow_mode_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/panel_btn_size">
                    <TextView
                        android:id="@+id/info_flow_mode_btn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:background="@drawable/ripple_drawable_20dp"
                        android:gravity="center"
                        android:text="@string/mode_info_flow_off"
                        android:textColor="@color/info_flow_btn_text"
                        android:textSize="11sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/remove_mode_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/panel_btn_size"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/remove_mode_btn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:background="@drawable/ripple_drawable_20dp"
                        android:gravity="center"
                        android:text="@string/mode_remove"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="11sp" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/remove_menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/block"
                        android:layout_width="@dimen/panel_btn_size"
                        android:layout_height="@dimen/panel_btn_size"
                        android:layout_gravity="center"
                        android:background="@drawable/ripple_drawable_20dp"
                        android:contentDescription="@string/accessibility_block"
                        android:src="@drawable/ic_block" />

                    <ImageButton
                        android:id="@+id/preview"
                        android:layout_width="@dimen/panel_btn_size"
                        android:layout_height="@dimen/panel_btn_size"
                        android:layout_gravity="center"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/ripple_drawable_20dp"
                        android:contentDescription="@string/accessibility_preview"
                        android:src="@android:drawable/ic_menu_view" />

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/modify_mode_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/panel_btn_size"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/modify_mode_btn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:background="@drawable/ripple_drawable_20dp"
                        android:gravity="center"
                        android:text="@string/mode_modify"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="11sp" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/modify_menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/modify"
                        android:layout_width="@dimen/panel_btn_size"
                        android:layout_height="@dimen/panel_btn_size"
                        android:layout_gravity="center"
                        android:background="@drawable/ripple_drawable_20dp"
                        android:contentDescription="@string/accessibility_modify"
                        android:src="@drawable/ic_modify" />

                    <ImageButton
                        android:id="@+id/modify_preview"
                        android:layout_width="@dimen/panel_btn_size"
                        android:layout_height="@dimen/panel_btn_size"
                        android:layout_gravity="center"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/ripple_drawable_20dp"
                        android:contentDescription="@string/accessibility_modify_preview"
                        android:src="@android:drawable/ic_menu_view" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/undo"
                    android:layout_width="@dimen/panel_btn_size"
                    android:layout_height="@dimen/panel_btn_size"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/ripple_drawable_20dp"
                    android:contentDescription="@string/accessibility_undo"
                    android:enabled="false"
                    android:src="@drawable/ic_undo" />

            </LinearLayout>

            <!-- 选择组在右（外侧）：滑条容器 + exchange + Up + Down（顺序 slider→exchange→Up→Down，与竖屏一致） -->
            <!-- 组内节奏：首项 marginTop 0，其余直接子项 marginTop 4；SeekBar 保持 rotation=90 竖置复用 -->
            <LinearLayout
                android:id="@+id/selection_group"
                android:layout_width="@dimen/panel_selection_col_w"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/panel_seek_len">

                    <SeekBar
                        android:id="@+id/slider"
                        android:layout_width="@dimen/panel_seek_len"
                        android:layout_height="@dimen/panel_selection_col_w"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:rotation="90" />

                </FrameLayout>

                <ImageButton
                    android:id="@+id/exchange"
                    android:layout_width="@dimen/panel_btn_size"
                    android:layout_height="@dimen/panel_btn_size"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/ripple_drawable_20dp"
                    android:contentDescription="@string/accessibility_exchange"
                    android:src="@drawable/exchange" />

                <ImageButton
                    android:id="@+id/Up"
                    android:layout_width="@dimen/panel_btn_size"
                    android:layout_height="@dimen/panel_btn_size"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/ripple_drawable_20dp"
                    android:contentDescription="@string/accessibility_up"
                    android:src="@drawable/up" />

                <ImageButton
                    android:id="@+id/Down"
                    android:layout_width="@dimen/panel_btn_size"
                    android:layout_height="@dimen/panel_btn_size"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/ripple_drawable_20dp"
                    android:contentDescription="@string/accessibility_down"
                    android:src="@drawable/down" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
